<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FileOrganizer.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="FileOrganizer.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        xmlns:icons="using:FluentIcons.Avalonia"
        Background="{DynamicResource PrimarySideMenuBackgroundColor}"
        Title="FileOrganizer">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>
    
    <Grid ColumnDefinitions="200, *">
        <ContentControl Grid.Column="1" Content="{Binding SelectedViewModel}"></ContentControl>
        
        <Border Grid.Column="0">
            <StackPanel Orientation="Vertical" Spacing="10">
                <icons:SymbolIcon Symbol="VehicleTruckProfile" FontSize="60"></icons:SymbolIcon>
                <Separator Margin="0 5 0 0" Width="200"></Separator>
                <Button Classes.active="{Binding HomePageIsActive}" Command="{Binding GoToHomeCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <icons:SymbolIcon></icons:SymbolIcon>
                        <Label Content="Home"></Label>
                    </StackPanel>
                </Button>
                <Button Classes.active="{Binding SettingsPageIsActive}" Command="{Binding GoToSettingsCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                       <icons:SymbolIcon Symbol="Settings"></icons:SymbolIcon>
                        <Label Content="Settings"></Label>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>

</Window>
