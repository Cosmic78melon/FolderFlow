<Window
    Background="{DynamicResource PrimarySideMenuBackgroundColor}"
    Icon="/Assets/avalonia-logo.ico"
    Title="FileOrganizer"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d"
    x:Class="FileOrganizer.Views.MainWindow"
    x:DataType="vm:MainWindowViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:icons="using:FluentIcons.Avalonia"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:msg="https://github.com/xiyaowong/Message.Avalonia"
    xmlns:views="using:FileOrganizer.Views"
    xmlns:vm="using:FileOrganizer.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Design.DataContext>
        <!--
            This only sets the DataContext for the previewer in an IDE,
            to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs)
        -->
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Grid ColumnDefinitions="200, *">
        <Border BorderBrush="DarkBlue" Grid.Column="0">
            <StackPanel Orientation="Vertical" Spacing="30">
                <icons:SymbolIcon
                    FontSize="60"
                    Foreground="AliceBlue"
                    Margin="0,10,0,0"
                    Symbol="Folder" />
                <TextBlock
                    FontSize="30"
                    Foreground="AliceBlue"
                    HorizontalAlignment="Center"
                    Margin="0,-20,0,0"
                    Text="FolderFlow" />
                <Button
                    Classes.active="{Binding HomePageIsActive}"
                    Command="{Binding GoToHomeCommand}"
                    Foreground="AliceBlue"
                    Margin="0,30,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <icons:SymbolIcon />
                        <Label Content="Home" />
                    </StackPanel>
                </Button>
                <Button Classes.active="{Binding SettingsPageIsActive}" Command="{Binding GoToSettingsCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <icons:SymbolIcon Symbol="Settings" />
                        <Label Content="Settings" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>


        <ContentControl Content="{Binding SelectedViewModel}" Grid.Column="1" />
    </Grid>

</Window>
